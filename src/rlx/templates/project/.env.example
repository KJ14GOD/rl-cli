# RLX LLM planner credentials
#
# Setup:
#   cp .env.example .env
#   # then open .env and add your own API key
#
# RLX reads .env from this project directory when you run commands here.

# Supported real providers:
#   openai  - hosted API, requires OPENAI_API_KEY
#   ollama  - local server, requires `ollama pull <model>` first
OPENAI_API_KEY=

# Optional OpenAI-compatible override. Leave blank for the official OpenAI API.
OPENAI_BASE_URL=

# Optional Ollama override. Leave blank for the default local server.
OLLAMA_BASE_URL=http://localhost:11434

# Project-local LLM planner defaults.
RLX_LLM_PROVIDER=openai
RLX_LLM_MODEL=gpt-5.4-mini
RLX_LLM_TIMEOUT=300

# Reserved for future providers.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
