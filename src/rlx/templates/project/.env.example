# RLX LLM planner credentials
#
# Setup:
#   cp .env.example .env
#   # then open .env and add your own API key
#
# RLX reads .env from this project directory when you run commands here.

# Current supported real provider:
OPENAI_API_KEY=

# Optional OpenAI-compatible override. Leave blank for the official OpenAI API.
OPENAI_BASE_URL=

# Optional defaults for future project-local configuration.
RLX_LLM_PROVIDER=openai
RLX_LLM_MODEL=gpt-5.4-mini
RLX_LLM_TIMEOUT=60

# Reserved for future providers.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

